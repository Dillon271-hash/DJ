# Copy this file to .env and fill in real values. Also add the same keys
# as Environment Variables in your Vercel project settings for the
# deployed version.

# https://developer.spotify.com/dashboard — create an app, then open its
# Settings to reveal these. Server-side only, never exposed to the
# browser. Powers artist profile photos.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# https://supabase.com/dashboard — create a free project, then open
# Project Settings → Data API to find these. Powers real accounts
# (sign up / log in) and stores logged sets in a real database instead
# of just localStorage. The VITE_ prefix means these ARE bundled into
# the browser — that's expected: the anon key is safe to expose because
# access is enforced by the Row Level Security policies in
# supabase/schema.sql (run that file once in your project's SQL Editor
# before using sign-up).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
