# Copy this file to .env and fill in real values. Used server-side only
# — never exposed to the browser. Also add the same keys as Environment
# Variables in your Vercel project settings for the deployed version.

# https://developer.spotify.com/dashboard — create an app, then open its
# Settings to reveal these. Powers artist profile photos.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# https://location.foursquare.com/developer/ — create a free account and
# project to get an API key. Powers venue search/autocomplete.
FOURSQUARE_API_KEY=
